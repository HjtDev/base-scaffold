# .env.example — template for the root .env. See BASE-DESIGN.md §4.4.
#
# Scope: COMPOSE-LEVEL INTERPOLATION ONLY. Nothing in here reaches Django — Django's
# settings come from backend/.env via python-decouple, and the frontend's from
# frontend/.env.local. Anything added here is visible only to docker-compose*.yml.
#
# NOT loaded automatically — copy to .env and fill it in; .env is gitignored:
#   cp .env.example .env
#
# On the production server the same keys live in a root .env.prod, which
# deploy/deploy-prod.sh passes with --env-file (BASE-DESIGN.md §9 step 3).

# ---------------------------------------------------------------------------- identity
# (required) Drives every container_name and the compose project name. Two projects
# sharing a PROJECT_NAME means their containers collide — so this has no default and
# compose refuses to start without it. scripts/rename-project.sh (§11.1) is what replaces
# "myproject" across the repo when a project is cloned from this scaffold.
PROJECT_NAME=myproject

# ---------------------------------------------------------------------------- host ports
# Left of the colon only — the in-container ports are fixed. Change these when two
# projects run side by side. docker-compose.test.yml uses 55432/56379 and never collides.
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# Deliberately NOT named POSTGRES_PORT: that key belongs to backend/.env and means "the
# port Django connects to inside the compose network" (5432, the container's own port).
# Same name would mean a different thing — compose would happily interpolate the wrong one.

# ---------------------------------------------------------------------------- tooling profile
# Only used by `docker compose --profile tooling up`.
FLOWER_PORT=5555
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025

# ---------------------------------------------------------------------------- production only
# Unused by docker-compose.yml; required by docker-compose.prod.yml.
#
# NEXT_PUBLIC_API_URL is a BUILD ARG for frontend/Dockerfile.prod — NEXT_PUBLIC_* is
# inlined into the client bundle at build time, so it cannot be a runtime env var and it
# cannot come from frontend/.env.local. Changing it means rebuilding the image.
# NEXT_PUBLIC_API_URL=https://api.example.com

# Uvicorn worker processes — derive from the server's CPU count. Defaults to 3 if unset.
# UVICORN_WORKERS=3
