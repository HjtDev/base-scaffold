# .env.prod.example — template for the root .env.prod. See BASE-DESIGN.md §4.4 and §9.
#
# Scope: same as .env.example — COMPOSE-LEVEL INTERPOLATION ONLY, read by
# docker-compose.prod.yml. This file lives ONLY on the production server; it is never
# synced from a developer machine (deploy-prod.sh's rsync excludes enforce this — §9 step 2).
#
# deploy-prod.sh passes it explicitly with --env-file on every compose invocation. Without
# --env-file, compose auto-loads a plain ".env" instead and docker-compose.prod.yml's
# `PROJECT_NAME:?` guard aborts (or, worse, silently reuses the dev .env's PROJECT_NAME and
# collides with the dev stack's container names) — this file existing is not optional.
#
# Create it once on the server:
#   cp .env.prod.example .env.prod   # then fill it in; NOT committed, NOT rsynced

# ---------------------------------------------------------------------------- identity
# (required) Drives every container_name and the compose project name — same rule as
# .env.example. Must match what scripts/rename-project.sh set when this project was cloned.
PROJECT_NAME=myproject

# ---------------------------------------------------------------------------- host ports
# nginx (host-level, not a compose service — see §9) proxies to these on 127.0.0.1.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---------------------------------------------------------------------------- frontend build
# (required) NEXT_PUBLIC_API_URL is a BUILD ARG for frontend/Dockerfile.prod —
# NEXT_PUBLIC_* is inlined into the client bundle at build time. Changing it means
# rebuilding the image (docker compose build --pull), never just restarting.
NEXT_PUBLIC_API_URL=https://api.example.com

# ---------------------------------------------------------------------------- backend runtime
# Uvicorn worker processes — derive from the server's CPU count. Defaults to 3 if unset.
# UVICORN_WORKERS=3

# ------------------------------------------------------------------- analytics profile
# Optional self-hosted Umami analytics. Off by default: docker-compose.prod.yml defines
# umami-db/umami behind the `analytics` compose profile, and deploy-prod.sh passes this
# file with --env-file, so uncommenting the line below is what actually activates them —
# no --profile flag needed anywhere else. Leave it commented for a project that isn't
# paying for analytics.
# COMPOSE_PROFILES=analytics

# The three keys below are read with an empty (`:-`) default in docker-compose.prod.yml,
# not `:?` — compose interpolates every service's variables at parse time regardless of
# which profiles are active, so a `:?` guard here would break `docker compose build` for
# every project that never enables analytics. deploy-prod.sh's step 7 is the real
# enforcement: it fails the deploy if COMPOSE_PROFILES includes "analytics" and any of
# these are still empty — so they are only actually required once you uncomment the line
# above.
# (required if analytics is enabled) generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
UMAMI_DB_PASSWORD=
# (required if analytics is enabled) generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
UMAMI_APP_SECRET=
# (required if analytics is enabled) generate: python3 -c "import secrets; print(secrets.token_hex(32))"
UMAMI_TWO_FACTOR_ENCRYPTION_KEY=

# nginx binds Umami at 127.0.0.1:${UMAMI_PORT} — see README.md "Deployment" for the
# analytics.<domain> server block to add by hand; this scaffold does not manage nginx.
UMAMI_PORT=3001
# (required if analytics is enabled) the public URL Umami will be reachable at.
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
# (required if analytics is enabled, filled in AFTER first deploy) empty here means the
# frontend build renders no script tag — see docker-compose.prod.yml's frontend build
# args and frontend/Dockerfile.prod. Register the site in the Umami dashboard first, then
# set this and rebuild: docker compose -f docker-compose.prod.yml --env-file .env.prod
# up -d --build frontend. A restart alone does NOT pick this up — it's baked in at build.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Umami ships with a hardcoded admin/umami login that CANNOT be overridden by env (no
# upstream support for setting it via config). If you enable analytics, log in and change
# that password immediately after the first deploy — BEFORE the analytics.<domain> DNS
# record is made public. Between those two moments, anyone who finds the host owns the
# dashboard. UMAMI_TWO_FACTOR_ENCRYPTION_KEY above is what makes enabling 2FA possible
# once you're in, which is the strongest mitigation available since the password itself
# can't be pre-set.
