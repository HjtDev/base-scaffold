# syntax=docker/dockerfile:1.7
# Production frontend image — BASE-DESIGN.md §8.1. Standard Next.js multi-stage, using
# `output: "standalone"` (frontend/next.config.ts) so the runner copies only the files
# Next traced as actually needed, not the whole node_modules tree.
FROM node:24-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# vendor/ before npm ci: a package.json "file:./vendor/..." dependency (appkit's frontend
# half, currently — see vendor/README.md) has to exist in the build context before npm
# resolves it, same requirement package.json/package-lock.json already have.
# TODO(appkit): this COPY and the vendored tarball it copies are a workaround for a
# confirmed appkit packaging bug, not the normal install path — remove once appkit ships
# an installable frontend half and package.json goes back to a real git dependency.
COPY vendor ./vendor
# --mount=type=ssh supports a private app-package repo's frontend half with no credential
# baked into any layer — INTEGRATION-GUIDE.md §2. CI's docker-build job forwards an agent
# via `--ssh default`; a local `docker compose build` needs one too for a private repo.
RUN --mount=type=cache,target=/root/.npm --mount=type=ssh npm ci

FROM node:24-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
# NEXT_PUBLIC_* is inlined into the client bundle at BUILD time — it must be a build ARG,
# not a runtime env var. Changing it means rebuilding the image, not restarting it.
# Optional analytics — see docker-compose.prod.yml and .env.prod.example. Empty ARG
# defaults keep this image buildable for a project that never enables analytics; the
# same build-time-only rule applies (enabling it later means `up -d --build frontend`,
# never just a restart).
ARG NEXT_PUBLIC_UMAMI_SCRIPT_URL=
ARG NEXT_PUBLIC_UMAMI_WEBSITE_ID=
ENV NEXT_PUBLIC_UMAMI_SCRIPT_URL=$NEXT_PUBLIC_UMAMI_SCRIPT_URL
ENV NEXT_PUBLIC_UMAMI_WEBSITE_ID=$NEXT_PUBLIC_UMAMI_WEBSITE_ID
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
RUN addgroup -g 10001 nodejs && adduser -S -u 10001 -G nodejs nextjs
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
USER nextjs
EXPOSE 3000
ENV PORT=3000 HOSTNAME=0.0.0.0
CMD ["node", "server.js"]
