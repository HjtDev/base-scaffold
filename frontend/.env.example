# frontend/.env.example — template for frontend/.env.local (Next.js dev config). See
# BASE-DESIGN.md §4.4. NOT loaded automatically — copy to frontend/.env.local and fill in
# real values; frontend/.env.local is gitignored.
#
# NEXT_PUBLIC_* variables are inlined into the client bundle at BUILD time, not read at
# runtime — changing one means rebuilding, not restarting. See BASE-DESIGN.md §8.1. This
# is also the only file in the repo allowed to contain a hardcoded backend URL; every
# other file resolves it from this variable at runtime.

# (required)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- installed frontend app packages append their keys below, per their own README
