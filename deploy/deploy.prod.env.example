# deploy/deploy.prod.env.example — template for deploy/deploy.prod.env. See
# BASE-DESIGN.md §9. This file configures WHERE deploy-prod.sh deploys to; it is separate
# from the root .env.prod / backend/.env.prod, which configure the application itself and
# live only on the server.
#
# deploy.prod.env is gitignored (see .gitignore) — it never leaves the machine that runs
# the deploy.
#
#   cp deploy/deploy.prod.env.example deploy/deploy.prod.env   # then fill it in

# ---------------------------------------------------------------------------- target server
# (required) Hostname or IP of the production server.
SERVER_HOST=

# (required) SSH user. Needs: docker + docker compose, write access to SERVER_PATH, and
# passwordless sudo for `nginx -t` / `systemctl reload nginx` if nginx runs on this host
# (see the "nginx" section below).
SERVER_USER=

# (required) Absolute path on the server this repo is rsynced into. Created if it doesn't
# exist. root/.env.prod and backend/.env.prod must already exist here before the first
# deploy — deploy-prod.sh checks for them and refuses to deploy if either is missing.
SERVER_PATH=/opt/my-client-project

# (optional) defaults to 22.
SSH_PORT=22

# (optional) path to a private key, if not using the default SSH identity / ssh-agent.
SSH_KEY_PATH=

# ---------------------------------------------------------------------------- health gate
# (optional) how long, in seconds, to wait for the backend container to report `healthy`
# before giving up and dumping its logs. Defaults below match the backend healthcheck's
# own start_period (40s) plus several retry intervals of slack.
HEALTH_TIMEOUT=300
HEALTH_INTERVAL=5

# ---------------------------------------------------------------------------- nginx
# nginx is a host-level reverse proxy, not a compose service (§9) — it fronts the
# 127.0.0.1-bound backend/frontend ports. deploy-prod.sh runs `nginx -t` and, only if that
# passes, reloads it. SERVER_USER needs a NOPASSWD sudoers entry for exactly these two
# commands, e.g.:
#   <SERVER_USER> ALL=(root) NOPASSWD: /usr/sbin/nginx -t, /usr/bin/systemctl reload nginx
#
# Set to 1 to skip the nginx step entirely (e.g. nginx isn't installed on this host, or a
# different process manages it).
# SKIP_NGINX_RELOAD=0
