# backend/.env.prod.example — template for backend/.env.prod (same keys as
# backend/.env.example, production values). See BASE-DESIGN.md §4.4.
#
# backend/.env.prod is NEVER synced from a developer machine — it lives only on the
# server. deploy-prod.sh's rsync excludes enforce this; see BASE-DESIGN.md §4.4/§9.
#
# Same convention as backend/.env.example: a key with no code default ships live and
# (required); a key with a code default ships commented out, showing that default.

# ---------------------------------------------------------------------------- core
DEBUG=False
# (required) generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# (required) comma-separated, the real production host name(s) — never "*". MUST include
# 127.0.0.1: docker-compose.prod.yml's backend healthcheck runs `curl` against
# http://127.0.0.1:8000/healthz/ from inside the container, and CommonMiddleware enforces
# ALLOWED_HOSTS on every request, healthchecks included — omit it and the container never
# reports healthy. See docs/BASE-DESIGN.md §8.2.
ALLOWED_HOSTS=127.0.0.1
# (required) generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# (optional) empty = Sentry inert. Set to the real project DSN to activate.
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------- database
# (required)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# CONN_MAX_AGE=60

# ---------------------------------------------------------------------------- cache / celery
# (required) e.g. redis://redis:6379/0
REDIS_URL=
# CELERY_BROKER_URL=            # defaults to REDIS_URL
# CELERY_RESULT_BACKEND=        # defaults to REDIS_URL

# ---------------------------------------------------------------------------- email
# (required) — config.E004 fails the startup check if this is empty or still "mailpit"
# with DEBUG off. mailpit only exists behind the dev `tooling` compose profile; production
# needs a real SMTP provider.
EMAIL_HOST=
# EMAIL_PORT=1025
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@localhost

# ---------------------------------------------------------------------------- cors
# (optional) comma-separated origins, e.g. https://app.example.com
# CORS_ALLOWED_ORIGINS=
# (optional) only if an installed auth app uses cross-origin cookies. Incompatible with a
# wildcard origin — CORS_ALLOWED_ORIGINS above must stay an explicit list. See
# BASE-DESIGN.md §3, "Auth integration".
# CORS_ALLOW_CREDENTIALS=False

# ---------------------------------------------------------------------------- security
# Defaults follow `not DEBUG` (i.e. secure) here, EXCEPT SECURE_HSTS_SECONDS — a year of
# HSTS is effectively irreversible for the domain and every subdomain, so it must be set
# explicitly rather than inherited.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
# TRUST_PROXY_SSL_HEADER=True
# (optional) comma-separated, the frontend origin(s) — only needed once a cookie-session
# auth app is installed. e.g. https://app.example.com
# CSRF_TRUSTED_ORIGINS=

# ---- installed app packages append their keys below, per their own README
