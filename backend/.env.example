# backend/.env.example — template for backend/.env (Django dev settings, DB creds, Redis
# URL, app package keys). See BASE-DESIGN.md §4.4. NOT loaded automatically — copy to
# backend/.env and fill in real values; backend/.env is gitignored.
#
# Convention:
#   - A key with NO default in config/settings.py ships live, with an empty or obvious
#     placeholder value, and is marked (required).
#   - A key WITH a code default ships commented out, showing that default — leaving it
#     commented and uncommenting only to override matters because `decouple.config(...)`
#     casts the raw string: an empty value for a bool/int/float cast (e.g.
#     `SECURE_HSTS_SECONDS=`) raises at import time instead of falling back to the default.
#   - DEBUG is the one exception: it has a code default (False) but is shipped live here,
#     set to the value that actually matches this file's purpose (dev vs. prod).

# ---------------------------------------------------------------------------- core
DEBUG=True
# (required) generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=django-insecure-replace-me-see-env-example
# (required) comma-separated
ALLOWED_HOSTS=localhost,127.0.0.1
# (required) generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-a-generated-fernet-key

# (optional) empty = Sentry inert. Set to a real DSN to activate.
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------- database
# (required)
POSTGRES_DB=myproject
POSTGRES_USER=myproject
POSTGRES_PASSWORD=changeme
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# CONN_MAX_AGE=60

# ---------------------------------------------------------------------------- cache / celery
# (required) e.g. redis://redis:6379/0
REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=            # defaults to REDIS_URL
# CELERY_RESULT_BACKEND=        # defaults to REDIS_URL

# ---------------------------------------------------------------------------- email
# (optional, but differs from the code default) — the code default is smtp/mailpit, which
# is correct once the `tooling` compose profile is up (`docker compose --profile tooling
# up`, UI at http://localhost:8025). A plain `docker compose up` has no mailpit host to
# resolve, so this ships live as console — flip to smtp when you bring the profile up.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=mailpit
# EMAIL_PORT=1025
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=False
# DEFAULT_FROM_EMAIL=noreply@localhost

# ---------------------------------------------------------------------------- cors
# (optional, but differs from the code default) — the code default is "" (no origins
# allowed), which breaks the README's own Quick Start: the frontend at :3000 fetches
# /healthz/ from the backend at :8000 client-side (frontend/app/page.tsx), a cross-origin
# request the browser blocks without this. Ships live here, matching the dev stack's
# default FRONTEND_PORT (docker-compose.yml). Update it if FRONTEND_PORT changes.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# (optional) only if an installed auth app uses cross-origin cookies. Incompatible with a
# wildcard origin — CORS_ALLOWED_ORIGINS above must stay an explicit list. See
# BASE-DESIGN.md §3, "Auth integration".
# CORS_ALLOW_CREDENTIALS=False

# ---------------------------------------------------------------------------- security
# Defaults follow `not DEBUG` — override only if this environment's needs differ.
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# SECURE_HSTS_SECONDS=0
# TRUST_PROXY_SSL_HEADER=False
# (optional) comma-separated, e.g. http://localhost:3000 — only needed once a
# cookie-session auth app is installed.
# CSRF_TRUSTED_ORIGINS=

# ---- installed app packages append their keys below, per their own README
