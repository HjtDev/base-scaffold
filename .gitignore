# base-scaffold .gitignore — see docs/BASE-DESIGN.md §2 and §4.4
#
# Lockfiles are COMMITTED, never ignored: backend/uv.lock, frontend/package-lock.json.
# .python-version is COMMITTED too — it pins what CI and Docker provision.

# ---------------------------------------------------------------- Python
# setuptools artifact patterns are anchored to /backend/ where they'd otherwise be
# unanchored and match unrelated directories under frontend/ — e.g. bare `lib/` silently
# excluded frontend/lib/ (api-client.ts, query-client.ts) from git entirely. `build/` and
# `dist/` are left unanchored: both ecosystems legitimately produce them. See
# docs/CORRECTIONS.md.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
/backend/develop-eggs/
dist/
/backend/downloads/
/backend/eggs/
.eggs/
/backend/parts/
/backend/sdist/
/backend/var/
/backend/wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# uv / venv — never SQLite (docs/BASE-DESIGN.md §3: Postgres only, including tests)
.venv/
/backend/env/
/backend/venv/
/backend/ENV/

# ---------------------------------------------------------------- tool caches & coverage
.ruff_cache/
.mypy_cache/
.pytest_cache/
.dmypy.json
dmypy.json
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.cache

# ---------------------------------------------------------------- Django / Celery
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
celerybeat-schedule
staticfiles/
media/
logs/

# ---------------------------------------------------------------- Node / Next.js
node_modules/
.next/
out/
coverage/
npm-debug.log*
next-env.d.ts
*.tsbuildinfo

# ---------------------------------------------------------------- env files (docs/BASE-DESIGN.md §4.4)
# Every .env is gitignored; every .env.example is tracked and explicitly negated back in.
.env
.env.*
!.env.example
!.env.prod.example
!deploy/deploy.prod.env.example

# ---------------------------------------------------------------- editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# ---------------------------------------------------------------- misc
.ipynb_checkpoints
profile_default/
ipython_config.py
